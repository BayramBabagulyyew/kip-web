generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  userId    String     @id @unique @default(cuid())
  username  String     @unique
  password  String
  createdAt DateTime   @default(now())
  deletedAt DateTime?
  about     about[]
  gallery   gallery[]
  readMails mails[]
  news      news[]
  partners  partners[]
  projects  projects[]
}

model news {
  newsId       String    @id @unique @default(cuid())
  titleTm      String
  titleRu      String
  titleEn      String
  slug         String    @unique
  image        String
  video        String?
  published    Boolean
  isMain       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  authorId     String
  contentEn    String
  contentRu    String
  contentTm    String
  priority     Int?      @unique
  homeActivity Boolean   @default(false)
  author       users     @relation(fields: [authorId], references: [userId])
}

model projects {
  projectId     String    @id @unique @default(cuid())
  nameTm        String
  nameRu        String
  nameEn        String
  slug          String    @unique
  descriptionTm String
  descriptionRu String
  descriptionEn String
  logo          String
  workDate      DateTime  @db.Date
  images        String[]
  createdAt     DateTime  @default(now())
  deletedAt     DateTime?
  authorId      String
  priority      Int?      @unique
  homeActivity  Boolean   @default(false)
  cover         String
  companyTm     String?   @db.VarChar(255)
  companyRu     String?   @db.VarChar(255)
  companyEn     String?   @db.VarChar(255)
  endDate       DateTime? @default(now()) @db.Timestamp(6)
  author        users     @relation(fields: [authorId], references: [userId])
}

model partners {
  partnerId String          @id @unique @default(cuid())
  website   String?
  fileUrl   String
  type      partnerTypeEnum
  createdAt DateTime        @default(now())
  deletedAt DateTime?
  priority  Int?
  authorId  String
  author    users           @relation(fields: [authorId], references: [userId])
  nameTm    String?
  nameRu    String?
  nameEn    String?
  textTm    String?
  textRu    String?
  textEn    String?
  slug       String?         @unique
  catalogUrl String?
  gallery    gallery[]
}

model gallery {
  galleryId String    @id @unique @default(cuid())
  priority  Int?      @unique
  image     String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  authorId  String
  author    users     @relation(fields: [authorId], references: [userId])
  partnerId String?
  partner   partners? @relation(fields: [partnerId], references: [partnerId])
}

model mails {
  mailId    String    @id @unique @default(cuid())
  name      String
  email     String
  comment   String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  readBy    String?
  fileUrl   String?
  readUser  users?    @relation(fields: [readBy], references: [userId])
}

model about {
  aboutId   String    @id @unique @default(cuid())
  titleTm   String
  contentTm String
  titleRu   String
  contentRu String
  titleEn   String
  contentEn String
  authorId  String
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  taglineEn String
  taglineRu String
  taglineTm String
  author    users     @relation(fields: [authorId], references: [userId])
}

model contact {
  contactId     String   @id @unique @default(cuid())
  phone         String
  mobilePhone   String
  instagram     String?
  instagramLink String?
  info          String
  addressTm     String
  addressRu     String
  addressEn     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model information {
  infoId    String   @id @unique @default(cuid())
  info1     Json?
  info2     Json?
  info3     Json?
  info4     Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ecology {
  ecologyId String   @id @unique @default(cuid())
  images    String[] @default([])
  contentTm String
  contentRu String
  contentEn String
  video     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  titleEn   String
  titleRu   String
  titleTm   String
}

model productServices {
  id        String                  @id @unique @default(cuid())
  nameTm    String
  nameEn    String
  nameRu    String
  slug      String                  @unique
  logo      String
  contentTm String
  contentRu String
  contentEn String
  images    String[]
  type      productServicesTypeEnum
  priority  Int?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  deletedAt DateTime?
}

model catalogs {
  catalogId   String          @id @unique @default(cuid())
  catalogType catalogTypeEnum @unique
  fileUrl     String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model taglines {
  id        String    @id @default(cuid()) @db.VarChar(191)
  taglineTm String?
  taglineRu String?
  taglineEn String?
  createdAt DateTime? @default(now()) @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @updatedAt @db.Timestamp(6)
}

model presentations {
  presentationId String   @id @unique @default(cuid())
  file           String
  language       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum partnerTypeEnum {
  dealership
  clients
  projects
}

enum productServicesTypeEnum {
  service
  product
}

enum catalogTypeEnum {
  home
  productservices
}
